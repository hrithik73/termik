#!/bin/sh
# Report program status (OSC 7501) to the terminal running the agent.
# usage: osc7501 <idle|working|done|blocked|error|clear> [msg|@tool] [kind]
#   @tool reads tool_name from the hook JSON on stdin ("Using Bash").
#   env: OSC7501_APP (default claude-code), OSC7501_ID (record id)
# Terminals without OSC 7501 ignore the sequence.
state=$1 msg=${2:-} kind=${3:-}
input=$(cat)
[ "$msg" = "@tool" ] && msg="Using $(printf %s "$input" | sed -n 's/.*"tool_name" *: *"\([^"]*\)".*/\1/p')"
body="state=$state:app=${OSC7501_APP:-claude-code}"
[ -n "${OSC7501_ID:-}" ] && body="$body:id=$OSC7501_ID"
[ -n "$kind" ] && body="$body:kind=$kind"
[ -n "$msg" ] && body="$body:msg=$(printf %s "$msg" | base64 | tr -d '\n')"
seq=$(printf '\033]7501;%s\033\\' "$body")

# Hook stdout isn't the terminal. Use the controlling tty, else the nearest ancestor's tty.
{ printf %s "$seq" > /dev/tty; } 2>/dev/null && exit 0
pid=$PPID
while [ "${pid:-1}" -gt 1 ]; do
  t=$(ps -o tty= -p "$pid" | tr -d ' ')
  case $t in ""|"??") ;; *) printf %s "$seq" > "/dev/$t"; exit 0 ;; esac
  pid=$(ps -o ppid= -p "$pid" | tr -d ' ')
done
