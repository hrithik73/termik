#!/bin/sh
# Saves Claude's plan limits for Termik's footer. Termik's statusLine wrapper calls this; to call it from your own
# statusLine script instead: input=$(cat); printf %s "$input" | /path/to/termik-usage
# plutil ships with macOS, unlike jq.
d="$HOME/Library/Application Support/Termik"
plutil -extract rate_limits json -o "$d/usage.json.tmp" - 2>/dev/null && mv "$d/usage.json.tmp" "$d/usage.json"
exit 0
