#!/bin/sh
# Saves Claude's plan limits for Termik's footer. Call from your Claude statusLine script with its stdin JSON:
#   input=$(cat); printf %s "$input" | /path/to/termik-usage
d="$HOME/Library/Application Support/Termik"
jq -c '.rate_limits // empty' > "$d/usage.json.tmp" 2>/dev/null && mv "$d/usage.json.tmp" "$d/usage.json"
exit 0
