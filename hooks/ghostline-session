#!/bin/sh
# Records the Claude session running in a Ghostline tab, so Ghostline can `claude --resume` it after a relaunch.
# usage (Claude hooks): ghostline-session start|end   — hook JSON on stdin
# Ghostline sets GHOSTLINE_SESSION_FILE per tab; elsewhere this does nothing.
[ -n "${GHOSTLINE_SESSION_FILE:-}" ] || { cat >/dev/null; exit 0; }
input=$(cat)
field() { printf %s "$input" | sed -n "s/.*\"$1\" *: *\"\([^\"]*\)\".*/\1/p"; }
case $1 in
  start) id=$(field session_id); [ -n "$id" ] && printf %s "$id" > "$GHOSTLINE_SESSION_FILE" ;;
  # Quitting Ghostline ends Claude with reason "other": keep the record so the tab can resume.
  end) [ "$(field reason)" = other ] || rm -f "$GHOSTLINE_SESSION_FILE" ;;
esac
exit 0
