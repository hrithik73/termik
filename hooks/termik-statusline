#!/bin/sh
# Claude Code statusLine wrapper: saves plan limits for Termik's footer, then runs your own statusLine command, if any.
# usage: termik-statusline ['<your statusLine command>']   — statusline JSON on stdin
input=$(cat)
printf %s "$input" | "$(dirname "$0")/termik-usage"
[ -z "${1:-}" ] || printf %s "$input" | sh -c "$1"
