+
+    /// OSC 7501: forward the validated report body to the surface and
+    /// answer the support query.
+    fn programStatus(self: *StreamHandler, cmd: terminal.osc.Command.ProgramStatus) void {
+        switch (cmd) {
+            .query => |terminator| switch (terminator) {
+                inline else => |t| self.messageWriter(.{
+                    .write_stable = "\x1b]7501;?" ++ comptime t.string(),
+                }),
+            },
+            .report => |report| {
+                const body = if (report.data.len > 0) report.data else "state=clear";
+                if (apprt.surface.Message.WriteReq.init(self.alloc, body)) |req| {
+                    self.surfaceMessageWriter(.{ .program_status = req });
+                } else |err| {
+                    log.warn("error forwarding program status err={}", .{err});
+                }
+            },
+        }
+    }
 };
 
